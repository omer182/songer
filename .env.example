# Copy to .env and fill in. Never commit .env.

# From https://developer.spotify.com/dashboard → your Songer app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where the browser reaches the app. The Spotify redirect URI is PUBLIC_URL + /api/auth/callback
# and must be listed in the Spotify app settings exactly.
# Local dev: http://127.0.0.1:5173   (Spotify rejects "localhost"; use 127.0.0.1)
# Homeserver: https://songer.omersher.com
PUBLIC_URL=http://127.0.0.1:5173

# Base URL printed in the party QR code. Phones can't open 127.0.0.1, so in local dev
# set this to your PC's LAN address, e.g. http://192.168.1.20:5173. Defaults to PUBLIC_URL.
JOIN_BASE_URL=

# Random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_ENC_KEY=

# Optional: comma-separated Spotify user IDs allowed to sign in. Empty = anyone your Spotify app allows.
ALLOWED_SPOTIFY_IDS=

PORT=5100
DATA_DIR=./data
